# ── 端口速查（跟 docker-compose.yml / Docker Desktop 一一对应）──────────────
#   服务               宿主机侧（本机工具连这个）   容器内部（容器间互访）
#   mysql              3307                        3306
#   redis              6380                        6379
#   agent-checkpoints 5434                        5432
#   api               8001                        8000
#   web               3000                        3000
#
#   ⚠️ 下面 HOST 写 127.0.0.1 + 宿主机那组端口（3307/6380/5434），
#      给【宿主机本地】跑 api 用（PyCharm 里 uv run uvicorn main:app）。
#      真跑在 docker 容器里，HOST 要换成服务名、端口用右边那组：
#        mysql:3306 / redis:6379 / agent-checkpoints:5432
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:replace_with_random_urlsafe_32_char_secret@127.0.0.1:3307/ecommerce_operation
APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
REDIS_URL=redis://:replace_with_random_urlsafe_32_char_secret@127.0.0.1:6380/0
TASK_QUEUE_BACKEND=inline
CELERY_TASK_DEFAULT_QUEUE=generation
CELERY_AGENT_QUEUE=agent
CELERY_AGENT_WORKFLOW_QUEUE=agent.workflow
CELERY_MAINTENANCE_QUEUE=maintenance
AGENT_CHECKPOINT_DATABASE_URL=
AGENT_CHECKPOINT_HOST=127.0.0.1
AGENT_CHECKPOINT_PORT=5434
AGENT_CHECKPOINT_USER=agent
AGENT_CHECKPOINT_PASSWORD=replace_with_random_32_char_secret
AGENT_CHECKPOINT_DATABASE=agent_checkpoints
AGENT_MAX_TOTAL_TOKENS=12000
AGENT_MAX_REVISIONS=1
OTEL_SERVICE_NAME=ecommerce-operation-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTH_SECRET_KEY=dev-auth-secret-change-me
AUTH_TOKEN_EXPIRE_MINUTES=10080

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro

IMAGE_PROVIDER=dashscope
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=wan2.6-t2i
IMAGE_SIZE=1280*1280
IMAGE_WORKSPACE_ID=
IMAGE_POLL_INTERVAL_SECONDS=5
IMAGE_POLL_MAX_ATTEMPTS=24

VIDEO_PROVIDER=dashscope
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIDEO_API_KEY=
VIDEO_MODEL=wan2.6-t2v
VIDEO_SIZE=1280*720
VIDEO_DURATION=2
VIDEO_WORKSPACE_ID=
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_POLL_MAX_ATTEMPTS=36